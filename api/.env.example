# Copy to .env (never commit .env)
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Local Docker Postgres (docker compose up -d from the repo root).
# For a hosted DB (Neon): DATABASE_URL = pooled URL, DATABASE_URL_UNPOOLED = direct URL.
DATABASE_URL=postgresql://campusone:campusone@localhost:5433/campusone?schema=public
DATABASE_URL_UNPOOLED=postgresql://campusone:campusone@localhost:5433/campusone?schema=public

# Used only by `npm run db:seed` (fake demo data, never run in production)
SEED_ADMIN_EMAIL=admin@campusone.test
SEED_ADMIN_PASSWORD=ChangeMe-12345
