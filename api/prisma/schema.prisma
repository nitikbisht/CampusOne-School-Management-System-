// CampusOne database schema: Foundation (Phase 1).
// Rules: every tenant table has schoolId; academic data hangs off AcademicYear;
// history is never overwritten. Later phases (people, enrollment, attendance,
// exams, fees...) are added as new migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")          // pooled URL: used by the running app
  directUrl = env("DATABASE_URL_UNPOOLED") // direct URL: used by Prisma Migrate
}

enum AcademicYearStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model School {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String   @unique
  timezone  String   @default("UTC")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  roles              Role[]
  academicYears      AcademicYear[]
  classes            SchoolClass[]
  sections           Section[]
  subjectTypes       SubjectType[]
  subjects           Subject[]
  classSubjects      ClassSubject[]
  students           Student[]
  parents            Parent[]
  parentStudents     ParentStudent[]
  studentEnrollments StudentEnrollment[]
  attendances        Attendance[]
  leaveRequests      LeaveRequest[]
  leaveTypes         LeaveType[]
  studentMarks       StudentMark[]
  assignmentSubmissions AssignmentSubmission[]
  certificates       Certificate[]
  certificateTypes   CertificateType[]
  auditLogs          AuditLog[]
  periods            Period[]
  rooms              Room[]
  timetables         Timetable[]
  timetableEntries   TimetableEntry[]
  fees               Fee[]
  teacherEligibilities TeacherEligibility[]
  teacherAssignments TeacherAssignment[]

  @@map("schools")
}

// ---------- Identity & access ----------

model User {
  id           String    @id @default(uuid()) @db.Uuid
  schoolId     String    @db.Uuid
  email        String
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school                    School                 @relation(fields: [schoolId], references: [id])
  roles                     UserRole[]
  refreshTokens             RefreshToken[]
  timetableEntries          TimetableEntry[]       @relation("TeacherTimetableEntries")
  originalTimetableEntries  TimetableEntry[]       @relation("OriginalTeacherTimetableEntries")
  teacherEligibilities      TeacherEligibility[]   @relation("TeacherEligibilityTeacher")
  teacherAssignments        TeacherAssignment[]    @relation("TeacherAssignmentTeacher")

  @@unique([schoolId, email])
  @@index([schoolId])
  @@map("users")
}

// ---------- People (Students, Parents, Staff) ----------

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
  WITHDRAWN
  ON_LEAVE
}

model Student {
  id            String        @id @default(uuid()) @db.Uuid
  schoolId      String        @db.Uuid
  admissionNo   String
  firstName     String
  middleName    String?
  lastName      String
  dateOfBirth   DateTime      @db.Date
  gender        Gender
  bloodGroup    String?
  religion      String?
  category      String?       // General, SC, ST, OBC, etc.
  nationality   String?       @default("Indian")
  motherTongue  String?
  aadharNumber  String?
  photoUrl      String?
  status        StudentStatus @default(ACTIVE)
  admissionDate DateTime      @db.Date
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  school       School              @relation(fields: [schoolId], references: [id])
  parents      ParentStudent[]
  enrollments  StudentEnrollment[]
  attendances  Attendance[]
  leaves       LeaveRequest[]
  marks        StudentMark[]
  assignments  AssignmentSubmission[]
  certificates Certificate[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([schoolId, status])
  @@map("students")
}

model Parent {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @db.Uuid
  firstName     String
  middleName    String?
  lastName      String
  email         String?
  phone         String
  alternatePhone String?
  occupation    String?
  qualification String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school       School            @relation(fields: [schoolId], references: [id])
  children     ParentStudent[]

  @@index([schoolId])
  @@index([schoolId, email])
  @@map("parents")
}

model ParentStudent {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  parentId  String   @db.Uuid
  studentId String   @db.Uuid
  relation  String   // Father, Mother, Guardian, etc.
  createdAt DateTime @default(now())

  school   School   @relation(fields: [schoolId], references: [id])
  parent   Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([schoolId])
  @@index([schoolId, studentId])
  @@map("parent_students")
}

model StudentEnrollment {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @db.Uuid
  studentId      String   @db.Uuid
  academicYearId String   @db.Uuid
  classId        String   @db.Uuid
  sectionId      String   @db.Uuid
  rollNumber     Int?
  enrolledAt     DateTime @default(now())
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school         School       @relation(fields: [schoolId], references: [id])
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  class          SchoolClass  @relation(fields: [classId], references: [id])
  section        Section      @relation(fields: [sectionId], references: [id])

  @@unique([studentId, academicYearId])
  @@unique([academicYearId, classId, sectionId, rollNumber])
  @@index([schoolId])
  @@index([schoolId, academicYearId])
  @@index([schoolId, studentId])
  @@map("student_enrollments")
}

// Teacher eligibility: which class ranges and subjects a teacher can teach
model TeacherEligibility {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @db.Uuid
  teacherId     String   @db.Uuid  // User ID (teacher)
  subjectId     String   @db.Uuid
  classId       String   @db.Uuid  // Min class (e.g., Class 1)
  maxClassId    String?  @db.Uuid  // Max class (e.g., Class 5), null = single class
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school    School       @relation(fields: [schoolId], references: [id])
  teacher   User         @relation("TeacherEligibilityTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class     SchoolClass  @relation("TeacherEligibilityMinClass", fields: [classId], references: [id], onDelete: Cascade)
  maxClass  SchoolClass? @relation("TeacherEligibilityMaxClass", fields: [maxClassId], references: [id], onDelete: Cascade)

  @@unique([schoolId, teacherId, subjectId, classId])
  @@index([schoolId, teacherId])
  @@index([schoolId, subjectId])
  @@map("teacher_eligibilities")
}

// Teacher assignment: assigns teacher to class/section/subject for an academic year
model TeacherAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @db.Uuid
  teacherId      String   @db.Uuid  // User ID (teacher)
  academicYearId String   @db.Uuid
  subjectId      String   @db.Uuid
  classId        String   @db.Uuid
  sectionId      String   @db.Uuid
  isPrimary      Boolean  @default(true)  // Primary vs co-teacher
  assignedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school         School       @relation(fields: [schoolId], references: [id])
  teacher        User         @relation("TeacherAssignmentTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class          SchoolClass  @relation(fields: [classId], references: [id])
  section        Section      @relation(fields: [sectionId], references: [id])

  @@unique([schoolId, academicYearId, subjectId, classId, sectionId, teacherId])
  @@index([schoolId, academicYearId])
  @@index([schoolId, teacherId])
  @@index([schoolId, classId, sectionId])
  @@map("teacher_assignments")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School           @relation(fields: [schoolId], references: [id])
  users       UserRole[]
  permissions RolePermission[]

  @@unique([schoolId, name])
  @@map("roles")
}

// Global catalog of permissions, e.g. "academic_year:create" (module:action).
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  module      String
  action      String
  description String?

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ---------- Academic structure (masters) ----------

model AcademicYear {
  id        String             @id @default(uuid()) @db.Uuid
  schoolId  String             @db.Uuid
  name      String
  startDate DateTime           @db.Date
  endDate   DateTime           @db.Date
  status    AcademicYearStatus @default(DRAFT)
  isCurrent Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  school              School    @relation(fields: [schoolId], references: [id])
  sections            Section[]
  studentEnrollments  StudentEnrollment[]
  attendances         Attendance[]
  leaveRequests       LeaveRequest[]
  studentMarks        StudentMark[]
  timetables          Timetable[]
  timetableEntries    TimetableEntry[]
  fees                Fee[]
  teacherAssignments  TeacherAssignment[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("academic_years")
}

model SchoolClass {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @db.Uuid
  name         String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school              School    @relation(fields: [schoolId], references: [id])
  sections            Section[]
  subjects            ClassSubject[]
  studentEnrollments  StudentEnrollment[]
  attendances         Attendance[]
  leaveRequests       LeaveRequest[]
  timetableEntries    TimetableEntry[]
  fees                Fee[]
  teacherEligibilitiesMin TeacherEligibility[] @relation("TeacherEligibilityMinClass")
  teacherEligibilitiesMax TeacherEligibility[] @relation("TeacherEligibilityMaxClass")
  teacherAssignments  TeacherAssignment[]

  @@unique([schoolId, name])
  @@map("classes")
}

model Section {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @db.Uuid
  academicYearId String   @db.Uuid
  classId        String   @db.Uuid
  name           String
  capacity       Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // classTeacherId is added in the Teachers migration (Phase 2).

  school              School       @relation(fields: [schoolId], references: [id])
  academicYear        AcademicYear @relation(fields: [academicYearId], references: [id])
  class               SchoolClass  @relation(fields: [classId], references: [id])
  studentEnrollments  StudentEnrollment[]
  attendances         Attendance[]
  leaveRequests       LeaveRequest[]
  timetableEntries    TimetableEntry[]
  teacherAssignments  TeacherAssignment[]

  @@unique([academicYearId, classId, name])
  @@index([schoolId])
  @@map("sections")
}

// Configurable subject types (Core, Elective, Practical, ...): a master, not an enum.
model SubjectType {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())

  school   School    @relation(fields: [schoolId], references: [id])
  subjects Subject[]

  @@unique([schoolId, name])
  @@map("subject_types")
}

model Subject {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @db.Uuid
  subjectTypeId String   @db.Uuid
  name          String
  code          String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school         School            @relation(fields: [schoolId], references: [id])
  subjectType    SubjectType       @relation(fields: [subjectTypeId], references: [id])
  classes        ClassSubject[]
  timetableEntries TimetableEntry[]
  teacherEligibilities TeacherEligibility[]
  teacherAssignments TeacherAssignment[]

  @@unique([schoolId, code])
  @@map("subjects")
}

// Which classes a subject applies to.
model ClassSubject {
  id        String @id @default(uuid()) @db.Uuid
  schoolId  String @db.Uuid
  classId   String @db.Uuid
  subjectId String @db.Uuid

  school  School      @relation(fields: [schoolId], references: [id])
  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([schoolId])
  @@map("class_subjects")
}

// Fee structure for the school
enum FeeFrequency {
  ONE_TIME
  MONTHLY
  QUARTERLY
  SEMESTER
  ANNUAL
}

model Fee {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @db.Uuid
  name           String
  description    String?
  amount         Decimal      @db.Decimal(10, 2)
  frequency      FeeFrequency
  academicYearId String       @db.Uuid
  classId        String?      @db.Uuid
  dueDate        DateTime?    @db.Date
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  school         School       @relation(fields: [schoolId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  class          SchoolClass? @relation(fields: [classId], references: [id])

  @@index([schoolId])
  @@index([schoolId, academicYearId])
  @@map("fees")
}

// ---------- Timetable (Phase 7) ----------

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TimetableStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Period master: time slots for the school day
model Period {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  name        String   // e.g., "Period 1", "Morning Assembly"
  startTime   String   // HH:MM format (24-hour)
  endTime     String   // HH:MM format (24-hour)
  displayOrder Int      @default(0)
  isBreak     Boolean  @default(false) // For recess, lunch breaks
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School            @relation(fields: [schoolId], references: [id])
  entries     TimetableEntry[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("periods")
}

// Room master for room allocation
model Room {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  name        String   // e.g., "Room 101", "Science Lab", "Auditorium"
  code        String   // Short code e.g., "R101", "SCI-LAB"
  capacity    Int?
  type        String?  // CLASSROOM, LAB, LIBRARY, AUDITORIUM, etc.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School            @relation(fields: [schoolId], references: [id])
  entries     TimetableEntry[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("rooms")
}

// Timetable: a published timetable for a specific scope (school, class, teacher)
model Timetable {
  id             String          @id @default(uuid()) @db.Uuid
  schoolId       String          @db.Uuid
  academicYearId String          @db.Uuid
  name           String          // e.g., "Class 10-A Timetable 2026-27"
  scope          String          // SCHOOL, CLASS, TEACHER
  scopeId        String?         // classId or teacherId when scope is CLASS or TEACHER
  status         TimetableStatus @default(DRAFT)
  version        Int             @default(1)
  publishedAt    DateTime?
  publishedById  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  school         School            @relation(fields: [schoolId], references: [id])
  academicYear   AcademicYear      @relation(fields: [academicYearId], references: [id])
  entries        TimetableEntry[]

  @@unique([schoolId, academicYearId, scope, scopeId, name])
  @@index([schoolId, academicYearId])
  @@index([schoolId, scope, scopeId])
  @@map("timetables")
}

// Individual entries in a timetable: which period, subject, teacher, room on which day
model TimetableEntry {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @db.Uuid
  timetableId  String   @db.Uuid
  academicYearId String @db.Uuid
  periodId     String   @db.Uuid
  dayOfWeek    DayOfWeek
  subjectId    String?  @db.Uuid // null for breaks/free periods
  teacherId    String?  @db.Uuid // userId of teacher
  roomId       String?  @db.Uuid
  classId      String?  @db.Uuid // for class-scoped timetables
  sectionId    String?  @db.Uuid
  isSubstitution Boolean @default(false)
  originalTeacherId String? @db.Uuid // for substitution tracking
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school       School         @relation(fields: [schoolId], references: [id])
  timetable    Timetable      @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id])
  period       Period         @relation(fields: [periodId], references: [id])
  subject      Subject?       @relation(fields: [subjectId], references: [id])
  teacher      User?          @relation("TeacherTimetableEntries", fields: [teacherId], references: [id])
  originalTeacher User?       @relation("OriginalTeacherTimetableEntries", fields: [originalTeacherId], references: [id])
  room         Room?          @relation(fields: [roomId], references: [id])
  class        SchoolClass?   @relation(fields: [classId], references: [id])
  section      Section?       @relation(fields: [sectionId], references: [id])

  @@unique([timetableId, periodId, dayOfWeek]) // One entry per period per day per timetable
  @@index([schoolId, timetableId])
  @@index([schoolId, academicYearId])
  @@index([schoolId, teacherId, dayOfWeek])
  @@index([schoolId, classId, sectionId, dayOfWeek])
  @@index([schoolId, roomId, dayOfWeek])
  @@map("timetable_entries")
}

// ---------- Auth tokens ----------

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------- People placeholders (fully implemented in later weeks) ----------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

model Attendance {
  id             String           @id @default(uuid()) @db.Uuid
  schoolId       String           @db.Uuid
  studentId      String           @db.Uuid
  academicYearId String           @db.Uuid
  classId        String           @db.Uuid
  sectionId      String           @db.Uuid
  date           DateTime         @db.Date
  status         AttendanceStatus @default(PRESENT)
  markedById     String           @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  school         School      @relation(fields: [schoolId], references: [id])
  student        Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  class          SchoolClass  @relation(fields: [classId], references: [id])
  section        Section      @relation(fields: [sectionId], references: [id])

  @@unique([studentId, academicYearId, date])
  @@index([schoolId, academicYearId, date])
  @@index([schoolId, classId, sectionId, date])
  @@map("attendances")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id             String      @id @default(uuid()) @db.Uuid
  schoolId       String      @db.Uuid
  studentId      String      @db.Uuid
  academicYearId String      @db.Uuid
  classId        String      @db.Uuid
  sectionId      String      @db.Uuid
  leaveTypeId    String      @db.Uuid
  startDate      DateTime    @db.Date
  endDate        DateTime    @db.Date
  reason         String
  status         LeaveStatus @default(PENDING)
  appliedById    String      @db.Uuid
  approvedById   String?
  approvedAt     DateTime?
  rejectionReason String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  school         School      @relation(fields: [schoolId], references: [id])
  student        Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  class          SchoolClass  @relation(fields: [classId], references: [id])
  section        Section      @relation(fields: [sectionId], references: [id])
  leaveType      LeaveType    @relation(fields: [leaveTypeId], references: [id])

  @@index([schoolId, studentId])
  @@index([schoolId, academicYearId, status])
  @@map("leave_requests")
}

model LeaveType {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  name        String
  description String?
  maxDays     Int?
  requiresDocument Boolean @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School        @relation(fields: [schoolId], references: [id])
  requests    LeaveRequest[]

  @@unique([schoolId, name])
  @@map("leave_types")
}

model StudentMark {
  id                String   @id @default(uuid()) @db.Uuid
  schoolId          String   @db.Uuid
  studentId         String   @db.Uuid
  academicYearId    String   @db.Uuid
  examId            String   @db.Uuid
  examSubjectId     String   @db.Uuid
  assessmentCompId  String   @db.Uuid
  marksObtained     Float?
  isAbsent          Boolean  @default(false)
  isDraft           Boolean  @default(true)
  enteredById       String   @db.Uuid
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  school            School     @relation(fields: [schoolId], references: [id])
  student           Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, examSubjectId, assessmentCompId])
  @@index([schoolId, academicYearId, examId])
  @@index([schoolId, studentId])
  @@map("student_marks")
}

model AssignmentSubmission {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @db.Uuid
  studentId     String   @db.Uuid
  assignmentId  String   @db.Uuid
  submittedAt   DateTime?
  content       String?
  attachments   String[] // JSON array of file paths
  marksObtained Float?
  feedback      String?
  gradedById    String?
  gradedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school        School     @relation(fields: [schoolId], references: [id])
  student       Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, assignmentId])
  @@index([schoolId, studentId])
  @@map("assignment_submissions")
}

model Certificate {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @db.Uuid
  studentId     String   @db.Uuid
  certificateTypeId String @db.Uuid
  title         String
  description   String?
  issuedDate    DateTime @db.Date
  certificateUrl String?
  issuedById    String   @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school        School     @relation(fields: [schoolId], references: [id])
  student       Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  certificateType CertificateType @relation(fields: [certificateTypeId], references: [id])

  @@index([schoolId, studentId])
  @@map("certificates")
}

model CertificateType {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  name        String
  description String?
  template    String?  // HTML template for certificate
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School       @relation(fields: [schoolId], references: [id])
  certificates Certificate[]

  @@unique([schoolId, name])
  @@map("certificate_types")
}

// ---------- Auditing ----------

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String?  @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  oldValue    Json?
  newValue    Json?
  reason      String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id])

  @@index([schoolId, entityType, entityId])
  @@index([schoolId, createdAt])
  @@map("audit_logs")
}
