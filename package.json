{
  "name": "campusone",
  "private": true,
  "description": "CampusOne: School ERP + Student Information System",
  "scripts": {
    "setup": "npm --prefix api install && npm --prefix web install",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm --prefix api run db:migrate --",
    "db:seed": "npm --prefix api run db:seed",
    "api:dev": "npm --prefix api run dev",
    "web:dev": "npm --prefix web run dev",
    "test": "npm --prefix api test",
    "typecheck": "npm --prefix api run typecheck"
  }
}
